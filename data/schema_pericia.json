    "conclusion": {
      "type": "object",
      "properties": {
        "consideraciones_tecnicas": { "type": "string", "description": "Análisis de compatibilidad físico-mecánica entre daños, huellas y dinámica." },
        "conclusion_pericial": { "type": "string", "description": "Cierre concluyente sintetizando la compatibilidad del evento." },
        "parrafo_remision_ingenieria_vial": { "type": "string", "description": "Párrafo estándar sugiriendo giro a División Ingeniería Vial." }
      },
      "required": ["consideraciones_tecnicas", "conclusion_pericial", "parrafo_remision_ingenieria_vial"]
